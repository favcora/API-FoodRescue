# Copie este arquivo para ".env" e ajuste os valores. NUNCA suba o ".env" para o GitHub.

# Banco de dados (SQLite por padrão; para PostgreSQL: postgresql+psycopg://user:senha@localhost/foodrescue)
DATABASE_URL=sqlite:///./food_rescue.db

# Chave usada para assinar os tokens JWT (gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
ACCESS_TOKEN_MINUTES=60

# Admin criado automaticamente na primeira execução (opcional)
ADMIN_EMAIL=admin@foodrescue.local
ADMIN_PASSWORD=troque-esta-senha

# Webhook: segredo usado para assinar (HMAC-SHA256) as notificações enviadas às ONGs
WEBHOOK_SECRET=troque-este-segredo
WEBHOOK_TIMEOUT_SECONDS=3

# Regra de compatibilidade
MAX_DISTANCE_KM=30
WEIGHT_CAPACITY=0.6
